@model GoldLoan.Web.Models.DashboardViewModel
﻿@{
    ViewData["Title"] = "Dashboard";
}

<div class="row">
    <div class="col-lg-4 col-md-6">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">Total Loans</h5>
                <p class="card-text">@Model.TotalLoans</p>
            </div>
        </div>
    </div>
    <div class="col-lg-4 col-md-6">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">Total Loan Amount</h5>
                <p class="card-text">@Model.TotalLoanAmount.ToString("C")</p>
            </div>
        </div>
    </div>
    <div class="col-lg-4 col-md-6">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">Active Loans</h5>
                <p class="card-text">@Model.ActiveLoans</p>
            </div>
        </div>
    </div>
</div>

<hr />

<div class="container-fluid">
    <div class="row">
        <div class="col-md-6">
            <h2>Defaulter List</h2>
            <table class="table table-striped">
                <thead>
                    <tr>
                        <th>Loan ID</th>
                        <th>Client Name</th>
                        <th>Principal Amount</th>
                        <th>Due Date</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var loan in Model.DefaulterLoans)
                    {
                        <tr>
                            <td>@loan.Id</td>
                            <td>@loan.ClientName</td>
                            <td>@loan.PrincipalAmount.ToString("C")</td>
                            <td>@loan.LoanDate.AddMonths(loan.TenureInMonths).ToShortDateString()</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="col-md-6">
            <h2>Upcoming Renewals (Next 30 Days)</h2>
            <table class="table table-striped">
                <thead>
                    <tr>
                        <th>Loan ID</th>
                        <th>Client Name</th>
                        <th>Principal Amount</th>
                        <th>Due Date</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var loan in Model.UpcomingRenewals)
                    {
                        <tr>
                            <td>@loan.Id</td>
                            <td>@loan.ClientName</td>
                            <td>@loan.PrincipalAmount.ToString("C")</td>
                            <td>@loan.LoanDate.AddMonths(loan.TenureInMonths).ToShortDateString()</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
